# Ejecuta pnpm setup para crear .env con secretos aleatorios.
POSTGRES_PASSWORD="GENERATE_WITH_SETUP"
DATABASE_URL="postgresql://nexus:GENERATE_WITH_SETUP@localhost:5432/nexus_db"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_SECRET="GENERATE_WITH_SETUP"
ENCRYPTION_KEY="GENERATE_WITH_SETUP"
OPENAI_API_KEY=""
MINIO_ROOT_USER="nexus_admin"
MINIO_ROOT_PASSWORD="GENERATE_WITH_SETUP"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_BUCKET="nexus-files"
SEED_ADMIN_EMAIL="admin@nexus.local"
SEED_ADMIN_PASSWORD="GENERATE_WITH_SETUP"
SCHEDULE_TIMEZONE="UTC"
